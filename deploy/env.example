# Copy to deploy/.env on the server (chmod 600). Never commit the real file.
SITE_DOMAIN=example.com
APP_URL=https://example.com
POSTGRES_PASSWORD=change-me-long-random
SESSION_SECRET=change-me-at-least-32-random-characters
# Shared secret between the app and the recognition service (any long random string)
RECOGNIZER_TOKEN=change-me-long-random
# Optional: RECOGNIZER_CPUS=2 / RECOGNIZER_MEMORY=2g / RECOGNITION_AUTO_IDENTIFY=false
# age public key for the nightly encrypted backups (age-keygen; keep the private key offline)
BACKUP_AGE_RECIPIENT=age1...
# Optional, as on Vercel:
# TIKTOK_CLIENT_KEY= / TIKTOK_CLIENT_SECRET=
# SMTP_HOST= / SMTP_PORT=587 / SMTP_USER= / SMTP_PASSWORD= / EMAIL_FROM=   (any mail provider; or RESEND_API_KEY=)
# HEALTH_TOKEN=   (detailed /api/health for an uptime monitor)
# STRIPE_SECRET_KEY= / STRIPE_WEBHOOK_SECRET= / STRIPE_PRICE_ID_STARTER= / STRIPE_PRICE_ID_GROWTH= / STRIPE_PRICE_ID_AGENCY=
# Imprint and privacy policy (see .env.example; /imprint shows a "before launch" note until the first four are set):
# IMPRESSUM_NAME= / IMPRESSUM_ADDRESS="Street 1 | 12345 City | Deutschland" / IMPRESSUM_EMAIL= / IMPRESSUM_PHONE=
# IMPRESSUM_REPRESENTATIVE= / IMPRESSUM_REGISTER= / IMPRESSUM_VAT_ID= / DSA_CONTACT_EMAIL= / PRIVACY_EMAIL=
# PRIVACY_SUPERVISORY_AUTHORITY= / PRIVACY_HOSTING_PROVIDER= / PRIVACY_EMAIL_PROVIDER=
