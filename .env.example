# Copy to .env for local development. Never commit real values — see
# ARCHITECTURE.md "Database architecture" for the server-side-secrets rule.

# Postgres connection string, for local development against a plain
# (non-Neon) Postgres. In Vercel, Neon is connected through the storage
# marketplace integration instead, which injects its own pair of vars
# instead of this one: `storagee_DATABASE_URL_UNPOOLED` (used by
# prisma.config.ts, for the CLI) and `storagee_POSTGRES_PRISMA_URL` (used
# by src/lib/prisma-client.ts, for the runtime pooled connection). Both
# fall back to this plain var when the storagee_* ones aren't set.
DATABASE_URL="postgresql://user:password@localhost:5432/rightswatch"

# Session auth
SESSION_SECRET="replace-with-a-long-random-string"

# Stripe (test mode). All five set → billing runs on Stripe; any one
# missing → clearly-labeled demo billing (MockPaymentProvider). Setup,
# including where each value comes from: STRIPE_INTEGRATION.md. In
# production these live in Vercel's environment variables, never here.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_STARTER=""
STRIPE_PRICE_ID_GROWTH=""
STRIPE_PRICE_ID_AGENCY=""

# Song search in the Rights Library: "musicbrainz" (the default — the open
# MusicBrainz database, no key needed) or "demo" (a fixed, fictional
# catalogue, for tests and for development without network access).
MUSIC_SEARCH_PROVIDER="musicbrainz"

# Email (password reset). Both set → sent through Resend; otherwise nothing is
# sent (locally the reset link is shown on the page). APP_URL is where links
# in emails point; on Vercel it falls back to the production domain.
RESEND_API_KEY=""
EMAIL_FROM=""
APP_URL=""

# TikTok Commercial Content API — left blank until access is confirmed
# (see ARCHITECTURE.md "Connector architecture" for the current status).
# Until these are set, the app runs against the mocked connector only.
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# Scheduled scans: Vercel Cron sends this as a bearer token to /api/cron/scans.
# Without it the endpoint refuses every call.
CRON_SECRET=""

# Background jobs (Upstash Redis, or any Redis-compatible URL)
REDIS_URL="redis://localhost:6379"

# Object storage (S3-compatible)
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_ENDPOINT=""

# Monitoring
SENTRY_DSN=""

# Set to "true" to force Demo Mode regardless of connector configuration
DEMO_MODE="true"
